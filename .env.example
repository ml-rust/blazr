# HuggingFace environment variables
# blazr reads no .env file. Export these variables before `blazr serve`.

# Your HuggingFace token (get it from https://huggingface.co/settings/tokens)
# Required for downloading private/gated models from HuggingFace Hub
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Custom HuggingFace cache directory
# Default: ~/.cache/huggingface
# HF_HOME=/path/to/custom/cache
